# ============================================
# L&D Operations Copilot — Local Environment
# ============================================
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# --- Google OAuth Credentials ---
OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=GOCSPX-your-client-secret
OAUTH_REFRESH_TOKEN=1//your-refresh-token

# --- Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# --- Google Sheets ---
ACE_SHEET_ID=your-spreadsheet-id-from-url

# --- API Security ---
API_TRIGGER_TOKEN=your-random-trigger-token

# --- App Config ---
USER_EMAIL=your-email@gmail.com
GCP_PROJECT_ID=your-gcp-project-id

# --- Runtime Mode ---
# Local: loaded from this .env file via python-dotenv
# Cloud Run: set via --set-env-vars at deploy time
